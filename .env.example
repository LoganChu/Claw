# NeMo Agent Toolkit / NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here

# LLM provider (OpenAI-compatible — can point to NIM, local Ollama, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Git monitoring
GIT_REPO_PATH=.  # path to monitor; defaults to current dir

# Google Calendar (optional — set to enable CalendarAgent)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json

# Slack (optional — set to enable CommunicationAgent)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C1234567890

# GitHub (optional — enables richer git metadata)
GITHUB_TOKEN=ghp_your_github_token

# App settings
LOG_LEVEL=INFO
DB_PATH=data/claw.db
VECTOR_STORE_PATH=data/vectors
REPORT_OUTPUT_DIR=reports
POLL_INTERVAL_SECONDS=300        # monitor agents poll every 5 min
ANALYSIS_INTERVAL_MINUTES=60     # orchestrator runs analysis hourly
EOD_REPORT_HOUR=18               # end-of-day report at 6 PM (24h)
